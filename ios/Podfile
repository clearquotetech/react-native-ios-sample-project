##############################################
# React Native + ClearQuoteSDK (SPM)
##############################################

require Pod::Executable.execute_command(
  'node',
  ['-p', 'require.resolve("react-native/scripts/react_native_pods.rb")'],
  __dir__
).strip

platform :ios, '16.0'
prepare_react_native_project!

############################################################
# React Native requires static frameworks
############################################################
use_frameworks! :linkage => :static

target 'MyApp' do

  ############################################################
  # REQUIRED — enables RN autolinking
  ############################################################
  config = use_native_modules!

  ############################################################
  # ClearQuoteSDK is installed via Swift Package Manager
  # (see MyApp.xcodeproj → Package Dependencies)
  ############################################################

  ############################################################
  # React Native
  ############################################################
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  ############################################################
  # POST INSTALL PATCHES
  ############################################################
  post_install do |installer|

    ##########################################################
    # Keep HERMES_CLI_PATH pointed at this checkout.
    # Stale absolute paths break the RN bundle script after moves.
    ##########################################################
    hermesc = File.expand_path(
      '../node_modules/hermes-compiler/hermesc/osx-bin/hermesc',
      __dir__
    )
    %w[debug release].each do |config|
      xcconfig = File.join(
        installer.sandbox.root,
        'Target Support Files/Pods-MyApp',
        "Pods-MyApp.#{config}.xcconfig"
      )
      next unless File.exist?(xcconfig) && File.exist?(hermesc)

      contents = File.read(xcconfig)
      updated = contents.gsub(
        /^HERMES_CLI_PATH = .*$/,
        "HERMES_CLI_PATH = #{hermesc}"
      )
      File.write(xcconfig, updated) if updated != contents
    end

    ##########################################################
    # Fix RN duplicate module / linker issues
    ##########################################################
    installer.pods_project.targets.each do |target|

      problematic = %w[
        ReactCommon
        react_runtime
        React-Runtime
        React-RuntimeHermes
        React-RuntimeApple
        React-RCTRuntime
        ReactCodegen
        react-native-safe-area-context
      ]

      if problematic.include?(target.name)
        target.build_configurations.each do |config|
          config.build_settings['DEFINES_MODULE'] = 'NO'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
      end

      ########################################################
      # Deployment target consistency
      ########################################################
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end

    ##########################################################
    # React Native final hook
    ##########################################################
    react_native_post_install(
      installer,
      config[:reactNativePath]
    )
  end
end
